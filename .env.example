# --- Server -------------------------------------------------------------------
# Where HQ keeps its SQLite file, and the address and port it listens on
# (defaults shown). Set HQ_HOST=0.0.0.0 to reach HQ from other machines.
# Leave these unset under Docker: the image keeps the database in /data and
# listens on every interface.
# HQ_DB=data/hq.sqlite
# HQ_HOST=127.0.0.1
# PORT=8787

# Where people reach this HQ (the server address people type into the app,
# calendar feeds). Leave unset for local use; set it once HQ is behind a domain.
# HQ_PUBLIC_URL=https://hq.example.com

# Days after it was made that an invite key can still sign a device in, used or
# not (default 7; 0 turns expiry off).
# HQ_INVITE_TTL_DAYS=7

# Largest file one chat upload may carry, in MB (default 100). Files are kept
# in a `files` folder beside the database.
# HQ_MAX_UPLOAD_MB=100

# Most one person may upload in all, in MB (default 2048). Files are never
# deleted, so this is what keeps the disk from filling.
# HQ_UPLOAD_QUOTA_MB=2048

# Most one person's synced coding conversations may hold in all, in MB (default 512). Only the latest snapshot of each is
# kept, so this is what keeps the disk from filling.
# HQ_TRANSCRIPT_QUOTA_MB=512

# Largest request body the server accepts, in MB. Defaults to the upload limit
# plus 1. Only uploads and meeting recordings may be that big: every other
# request is held to 1 MB (sign-in to 4 KB) unless an app route sets its own.
# HQ_MAX_BODY_MB=101

# Set to 1 when a reverse proxy you run sits in front of HQ and sets
# X-Forwarded-For, so sign-in attempts are counted per caller, not per proxy.
# HQ_TRUST_PROXY=1

# The team's time zone (IANA name). The assistant tells people times in it.
# Defaults to this machine's zone.
# HQ_TIMEZONE=America/New_York

# --- Push notifications (docs/push.md) --------------------------------------------
# Off unless all four are set. Needs your own Apple Developer account and a Mac or
# iPhone app you signed with your team (clients/apple/README.md, "Push notifications").
# The routes still accept and store device tokens when push is off.
#
# The path to the .p8 key Apple gave you. Keep it outside the data folder and
# outside git; mount it read-only under Docker. The key itself is never logged.
# HQ_APNS_KEY_FILE=/run/secrets/AuthKey_ABC1234567.p8
# The key's id and your team id (both are shown next to the key in your account).
# HQ_APNS_KEY_ID=ABC1234567
# HQ_APNS_TEAM_ID=TEAM123456
# Your app's bundle id: the app's BUNDLE_ID_PREFIX followed by .hq
# HQ_APNS_TOPIC=org.example.hq
# What a notification shows on the lock screen: `full` (room, sender and the first
# 240 characters of the message) or `hidden` (the sender and "New message").
# Either way Apple's servers carry what is shown. Default full.
# HQ_PUSH_PREVIEW=full

# --- Calls (docs/calls.md) -------------------------------------------------------
# Off unless the app id and a secret are set. Needs your own Cloudflare Realtime
# SFU app (Cloudflare dashboard, Realtime, Serverless SFU). Audio and video pass
# through Cloudflare; the first 1,000 GB a month are free, then $0.05 per GB.
# HQ_CALLS_SFU_APP_ID=
# The App Secret, or a file holding it (one or the other). Never logged.
# HQ_CALLS_SFU_SECRET=
# HQ_CALLS_SFU_SECRET_FILE=/run/secrets/hq-calls-sfu
# Only to point HQ at a compatible relay or a test fake.
# HQ_CALLS_SFU_URL=https://rtc.live.cloudflare.com/v1
# Devices in one call at once. Default 20.
# HQ_CALLS_MAX_PARTICIPANTS=20
# --- Call recordings (docs/calls.md#recordings-transcripts-and-recaps) ---
# Every call is recorded per person (about 115 MB per person-hour) and, with
# HQ_STT_* set, transcribed after it ends. All call audio kept, in MB; past it no
# new audio is kept. Recordings are never deleted. Default 10240; 0 keeps none.
# HQ_CALLS_RECORDING_QUOTA_MB=10240

# --- The model ------------------------------------------------------------------
# Any /chat/completions endpoint works. Pick one block, or leave all of this
# unset to run with an offline echo model. See docs/providers.md.

# OpenAI
# HQ_LLM_BASE_URL=https://api.openai.com/v1
# HQ_LLM_API_KEY=sk-...
# HQ_LLM_MODEL=gpt-5-mini

# Ollama (local, no key)
# HQ_LLM_BASE_URL=http://localhost:11434/v1
# HQ_LLM_MODEL=qwen3:14b

# Groq, Together, Mistral, DeepSeek, Fireworks, vLLM, LM Studio...: same three vars.

# Anthropic (native Messages API)
# HQ_LLM_PROVIDER=anthropic
# HQ_LLM_API_KEY=sk-ant-...
# HQ_LLM_MODEL=<model id>

# Reliability (defaults shown). HQ_LLM_FALLBACK_MODEL takes a comma-separated
# list, tried in order on the same endpoint.
# HQ_LLM_TIMEOUT_MS=120000
# HQ_LLM_RETRIES=2
# HQ_LLM_FALLBACK_MODEL=

# --- Other AI capabilities (docs/ai.md) ------------------------------------------
# Off until you set a model. Without a base URL they reuse HQ_LLM_BASE_URL and
# HQ_LLM_API_KEY. Set HQ_<NAME>_PROVIDER=mock for the offline mock.

# Embeddings, for semantic search in Docs
# HQ_EMBED_MODEL=nomic-embed-text
# HQ_EMBED_BASE_URL=
# HQ_EMBED_API_KEY=

# Speech-to-text, for meeting recordings (OpenAI, Groq, local whisper servers)
# HQ_STT_MODEL=whisper-1
# HQ_STT_BASE_URL=
# HQ_STT_API_KEY=
# HQ_STT_MAX_MB=25

# --- Connectors (docs/connectors.md) ---------------------------------------------
# Encrypts connector secrets at rest. Any long random string. Unset, HQ reads
# vault.key next to the database, which `bun hq setup` makes. Keep it safe:
# without it, every connector secret has to be entered again.
# HQ_VAULT_KEY=
